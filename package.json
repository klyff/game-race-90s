{
  "name": "concurrence-gamming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isometric arcade racer inspired by Rock N Roll Racing",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:sprites": "node --experimental-strip-types tools/spritegen/import-fleet.ts",
    "gen:fleet": "node --experimental-strip-types tools/spritegen/import-fleet.ts",
    "gen:cars-json": "node --experimental-strip-types tools/spritegen/write-matrix-manifest.ts",
    "gen:pack-redrawn": "node --experimental-strip-types tools/spritegen/pack-redrawn.ts",
    "gen:car-stats": "node --experimental-strip-types tools/spritegen/write-matrix-manifest.ts",
    "gen:qa-strip": "node --experimental-strip-types tools/spritegen/qa-strip.ts",
    "gen:fit-redrawn": "node --experimental-strip-types tools/spritegen/fit-redrawn.ts",
    "gen:fit-raw": "node --experimental-strip-types tools/spritegen/fit-raw-frames.ts",
    "gen:collision-maps": "node --experimental-strip-types tools/spritegen/write-collision-maps.ts",
    "gen:sprites-proc": "node tools/spritegen/generate.ts",
    "gen:preview": "node tools/spritegen/preview.ts",
    "gen:track": "node tools/trackgen/preview.ts",
    "gen:tracks": "node tools/trackgen/generate.ts",
    "gen:cameras": "node --experimental-strip-types tools/camgen/analyze.ts",
    "gen:traps": "node --experimental-strip-types tools/trapgen/analyze.ts",
    "gen:traps-art": "node --experimental-strip-types tools/art/generate-traps.ts",
    "gen:crowd": "node --experimental-strip-types tools/art/generate-crowd.ts",
    "gen:lines": "node tools/linegen/generate.ts",
    "gen:ground": "node --experimental-strip-types tools/art/generate-ground-tiles.ts",
    "gen:planet-select": "node --experimental-strip-types tools/art/generate-planet-select.ts",
    "gen:weapons": "node --experimental-strip-types tools/art/generate-weapons.ts",
    "gen:hud-icons": "node --experimental-strip-types tools/art/generate-hud-icons.ts",
    "gen:scraps": "node --experimental-strip-types tools/art/generate-metal-scraps.ts",
    "gen:carts": "node --experimental-strip-types tools/art/generate-cart-portraits.ts",
    "gen:car-strip": "bash tools/art/car-rotate/pipeline.sh",
    "gen:clock-coords": "node --experimental-strip-types tools/art/car-rotate/clock_coords.ts",
    "gen:strip-yaw": "python3 tools/art/car-rotate/overlay_strip_yaw.py",
    "gen:voice-lab": "node --experimental-strip-types tools/voicegen/generate-lab.ts",
    "gen:voice-lab:pt": "node --experimental-strip-types tools/voicegen/generate-lab.ts --locale pt-BR",
    "gen:voice-lab:en-new": "node --experimental-strip-types tools/voicegen/generate-lab.ts --locale en --force --ids lok-thant-enzo,holy-chimbeler,chimbeeler,porra-bruno-pronto,thanner-roadmap,caraio-thanner-vasco,oxente-doido,puta-merda-passou,cu-travou,eita-porrada",
    "debug:ia": "node --experimental-strip-types tools/debug/run-ia.ts",
    "debug:ia-capture": "node tools/debug/capture-ia.mjs",
    "gen:hero-300": "bash tools/art/gen-hero-300.sh"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
