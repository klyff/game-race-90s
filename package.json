{
  "name": "concurrence-gamming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isometric arcade racer inspired by Rock N Roll Racing",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:sprites": "node --experimental-strip-types tools/spritegen/import-fleet.ts",
    "gen:fleet": "node --experimental-strip-types tools/spritegen/import-fleet.ts",
    "gen:pack-redrawn": "node --experimental-strip-types tools/spritegen/pack-redrawn.ts",
    "gen:qa-strip": "node --experimental-strip-types tools/spritegen/qa-strip.ts",
    "gen:fit-redrawn": "node --experimental-strip-types tools/spritegen/fit-redrawn.ts",
    "gen:fit-raw": "node --experimental-strip-types tools/spritegen/fit-raw-frames.ts",
    "gen:collision-maps": "node --experimental-strip-types tools/spritegen/write-collision-maps.ts",
    "gen:sprites-proc": "node tools/spritegen/generate.ts",
    "gen:preview": "node tools/spritegen/preview.ts",
    "gen:track": "node tools/trackgen/preview.ts",
    "gen:tracks": "node tools/trackgen/generate.ts",
    "gen:lines": "node tools/linegen/generate.ts",
    "gen:ground": "node --experimental-strip-types tools/art/generate-ground-tiles.ts",
    "gen:planet-select": "node --experimental-strip-types tools/art/generate-planet-select.ts",
    "gen:weapons": "node --experimental-strip-types tools/art/generate-weapons.ts",
    "gen:scraps": "node --experimental-strip-types tools/art/generate-metal-scraps.ts",
    "gen:carts": "node --experimental-strip-types tools/art/generate-cart-portraits.ts",
    "gen:voice-lab": "node --experimental-strip-types tools/voicegen/generate-lab.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
